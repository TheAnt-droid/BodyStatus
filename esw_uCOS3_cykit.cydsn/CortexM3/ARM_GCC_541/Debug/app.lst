 256:APP/app.c     **** /*
 257:APP/app.c     **** ***************************************************************************************************
 258:APP/app.c     **** *                                          App_TaskLED()
 259:APP/app.c     **** *
 260:APP/app.c     **** * Description : LED Task pends on a semaphore which is controlled by App_TaskButton(). If the butto
 261:APP/app.c     **** *               pressed the semaphore is constantly posted and this task can toggle the LED (P2_1, 
 262:APP/app.c     **** *               If the button is not pressed and the semaphore is not posted, this task waits to in
 263:APP/app.c     **** *               until the button is pressed again. Via the define USE_BSP_TOGGLE both BSP functions
 264:APP/app.c     **** *               be tested. If USE_BSP_TOGGLE is TRUE the BSP_LED_Toggle() function will be used, ot
 265:APP/app.c     **** *               BSP_LED_Off() and BSP_LED_On() will be used.
 266:APP/app.c     **** *
 267:APP/app.c     **** * Argument(s) : p_arg   is the argument passed to 'App_TaskLED()' by 'OSTaskCreate()'.
 268:APP/app.c     **** *
 269:APP/app.c     **** * Return(s)   : none
 270:APP/app.c     **** *
 271:APP/app.c     **** * Note(s)     : none
 272:APP/app.c     **** ***************************************************************************************************
ARM GAS  C:\Users\roman\AppData\Local\Temp\cc3Iro1m.s 			page 8


 273:APP/app.c     **** */
 274:APP/app.c     **** 
 275:APP/app.c     **** 
 276:APP/app.c     **** static  void  App_TaskLED (void *p_arg)
 277:APP/app.c     **** {
 278:APP/app.c     ****   /* declare and define task local variables */
 279:APP/app.c     ****   OS_ERR       os_err;
 280:APP/app.c     ****   CPU_TS         ts;
 281:APP/app.c     ****   
 282:APP/app.c     ****   /* prevent compiler warnings */
 283:APP/app.c     ****   (void)p_arg;
 284:APP/app.c     ****   
 285:APP/app.c     ****   /* start of the endless loop */
 286:APP/app.c     ****   while (DEF_TRUE) {
